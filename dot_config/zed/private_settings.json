{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "which_key": {
    "enabled": true
  },
  "helix_mode": true,
  "vim_mode": false,
  "base_keymap": "Zed",
  "cursor_shape": "block",
  "ui_font_size": 14.0,
  "ui_font_family": ".SystemUIFont",
  "buffer_font_size": 14.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "restore_on_startup": "launchpad",
  "session": {
    "restore_unsaved_buffers": false
  },
  "reveal_if_open": true,
  "cli_default_open_behavior": "existing_window"
}
