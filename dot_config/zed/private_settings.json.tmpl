{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "auto_install_extensions": {{ .zed_extensions | toPrettyJson | indent 2 | trim }},
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "theme": {
    "mode": "system",
    "light": "macOS Classic Light",
    "dark": "macOS Classic Dark"
  },
  "languages": {
    "PHP": {
      "format_on_save": "on",
      "language_servers": ["phpantom", "!intelephense", "!phpactor", "!phptools", "..."]
    },
    "Astro": { "formatter": { "language_server": { "name": "biome" } } },
    "CSS": { "formatter": { "language_server": { "name": "biome" } } },
    "GraphQL": { "formatter": { "language_server": { "name": "biome" } } },
    "HTML": { "formatter": { "language_server": { "name": "biome" } } },
    "JSON": { "formatter": { "language_server": { "name": "biome" } } },
    "JSONC": { "formatter": { "language_server": { "name": "biome" } } },
    "JSX": { "formatter": { "language_server": { "name": "biome" } } },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Svelte": { "formatter": { "language_server": { "name": "biome" } } },
    "TSX": { "formatter": { "language_server": { "name": "biome" } } },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Vue.js": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "biome" } },  
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    }
  },
  "disable_ai": true,
  "bottom_dock_layout": "contained",
  "title_bar": {
    "show_menus": false,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": false,
    "show_onboarding_banner": true,
    "show_project_items": true
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "terminal": {
    "button": false
  },
  "status_bar": {
    "show": false,
    "line_endings_button": false,
    "cursor_position_button": false,
    "active_language_button": false
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": false
  },
  "tab_bar": {
    "show": false
  },
  "project_panel": {
    "button": false,
    "dock": "right"
  },
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "agent": {
    "button": false,
    "terminal_init_command": "",
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "button": false,
    "dock": "right"
  },
  "which_key": {
    "enabled": true
  },
  "helix_mode": true,
  "vim_mode": false,
  "base_keymap": "Zed",
  "cursor_shape": "block",
  "ui_font_size": 14.0,
  "ui_font_family": ".SystemUIFont",
  "buffer_font_size": 14.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "restore_on_startup": "launchpad",
  "session": {
    "restore_unsaved_buffers": false
  },
  "reveal_if_open": true,
  "cli_default_open_behavior": "existing_window"
}
