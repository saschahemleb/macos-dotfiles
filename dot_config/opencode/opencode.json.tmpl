{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./litellm-token-refresh"],
{{- if eq .workstation_type "work" }}
  "providers": {
    "litellm": {
      "name": "Eventim LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["LITELLM_API_KEY"],
      "settings": {
        "baseURL": "https://litellm.stg.enablement.ai.eventim.cloud/v1"
      },
      "body": {
        "drop_params": true
      },
      "models": {
        "opus": {
          "name": "Opus 5.5",
          "modelID": "bedrock-anthropic-eu-opus-55-expensive",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sonnet": {
          "name": "Sonnet 5.5",
          "modelID": "bedrock-anthropic-eu-sonnet-55-affordable",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sol": {
          "name": "Sol 6.1",
          "modelID": "openai-glob-sol-61-expensive",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh"] }
          },
          "limit": { "context": 922000, "output": 128000 }
        },
        "luna": {
          "name": "Luna 6",
          "modelID": "openai-glob-luna-6-cheap",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh"] }
          },
          "limit": { "context": 922000, "output": 128000 }
        }
      }
    }
  },
  "model": "litellm/opus",
{{- else }}
  "model": "openai/gpt-6.1-sol",
{{- end }}
  "update": "disable",
  "share": "disabled",
{{- if eq .workstation_type "work" }}
  "mcp": {
    "servers": {
      "eventim-mcp": {
        "type": "local",
        "command": ["node", "{{ .chezmoi.homeDir }}/Developer/git.eventim.net/shemleb/eventim-mcp/dist/index.js", "--stdio"]
      }
    }
  },
{{- end }}
  "agents": {
    "plan": {
      "disabled": true
    },
    "explore": {
{{- if eq .workstation_type "work" }}
      "model": "litellm/sonnet#low"
{{- else }}
      "model": "openai/gpt-6-luna#low"
{{- end }}
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/dev/null", "effect": "allow" },
{{- if env "TMPDIR" | hasPrefix "/var/" }}
    { "action": "external_directory", "resource": "/private{{ env "TMPDIR" | trimSuffix "/" }}/opencode/*", "effect": "allow" },
{{- end }}
    { "action": "external_directory", "resource": "~/Developer/*", "effect": "allow" },
{{- if eq .workstation_type "work" }}
    { "action": "eventim-mcp_*", "resource": "*", "effect": "ask" },
    { "action": "eventim-mcp_*-get-*", "resource": "*", "effect": "allow" },
    { "action": "eventim-mcp_*-list*", "resource": "*", "effect": "allow" },
    { "action": "eventim-mcp_*-search*", "resource": "*", "effect": "allow" },
    { "action": "eventim-mcp_jira-find-user", "resource": "*", "effect": "allow" },
    { "action": "eventim-mcp_grafana-ask-assistant", "resource": "*", "effect": "allow" },
{{- end }}
    { "action": "shell", "resource": "glab ci trace", "effect": "deny" }
  ]
}
