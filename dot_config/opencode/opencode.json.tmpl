{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./litellm-token-refresh"],
{{- if eq .workstation_type "work" }}
  "providers": {
    "litellm": {
      "name": "Eventim LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["LITELLM_API_KEY"],
      "settings": {
        "baseURL": "https://litellm.stg.enablement.ai.eventim.cloud/v1"
      },
      "body": {
        "drop_params": true
      },
      "models": {
        "opus": {
          "name": "Opus 5.5",
          "modelID": "bedrock-anthropic-eu-opus-55-expensive",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sonnet": {
          "name": "Sonnet 5.5",
          "modelID": "bedrock-anthropic-eu-sonnet-55-affordable",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sol": {
          "name": "Sol 6.1",
          "modelID": "openai-glob-sol-61-expensive",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh"] }
          },
          "limit": { "context": 922000, "output": 128000 }
        },
        "luna": {
          "name": "Luna 6",
          "modelID": "openai-glob-luna-6-cheap",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh"] }
          },
          "limit": { "context": 922000, "output": 128000 }
        }
      }
    }
  },
  "model": "litellm/opus",
{{- else }}
  "model": "openai/gpt-6.1-sol",
{{- end }}
  "default_agent": "build",
  "update": "disable",
  "share": "disabled",
  "worktree": {
    "directory": ".opencode/worktrees"
  },
{{- if eq .workstation_type "work" }}
  "mcp": {
    "servers": {
      "eventim-mcp": {
        "type": "local",
        "command": ["node", "{{ .chezmoi.homeDir }}/Developer/git.eventim.net/shemleb/eventim-mcp/dist/index.js", "--stdio"]
      }
    }
  },
{{- end }}
  "agents": {
    "build": {
{{- if eq .workstation_type "work" }}
      "model": "litellm/opus#high"
{{- else }}
      "model": "openai/gpt-6.1-sol#high"
{{- end }}
    },
    "plan": {
{{- if eq .workstation_type "work" }}
      "model": "litellm/opus#max"
{{- else }}
      "model": "openai/gpt-6.1-sol#xhigh"
{{- end }}
    },
    "explore": {
{{- if eq .workstation_type "work" }}
      "model": "litellm/sonnet#low"
{{- else }}
      "model": "openai/gpt-6-luna#low"
{{- end }}
    },
    "yolo": {
      "description": "Build without prompts: runs any command, including commits and pushes",
      "mode": "primary",
      "color": "#e5534b",
{{- if eq .workstation_type "work" }}
      "model": "litellm/opus#high",
{{- else }}
      "model": "openai/gpt-6.1-sol#high",
{{- end }}
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "kubectl *secret*", "effect": "ask" },
        { "action": "shell", "resource": "git push *--force*", "effect": "ask" },
        { "action": "shell", "resource": "git push -f*", "effect": "ask" },
        { "action": "shell", "resource": "git push * -f*", "effect": "ask" },
        { "action": "shell", "resource": "git push *+*", "effect": "ask" }
      ]
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/dev/null", "effect": "allow" },
{{- if env "TMPDIR" | hasPrefix "/var/" }}
