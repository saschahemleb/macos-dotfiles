{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./litellm-token-refresh"],
{{- if eq .workstation_type "work" }}
  "providers": {
    "litellm": {
      "name": "Eventim LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["LITELLM_API_KEY"],
      "settings": {
        "baseURL": "https://litellm.stg.enablement.ai.eventim.cloud/v1"
      },
      "body": {
        "drop_params": true
      },
      "models": {
        "opus": {
          "name": "Opus 5.5",
          "modelID": "bedrock-anthropic-eu-opus-55-expensive",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sonnet": {
          "name": "Sonnet 5.5",
          "modelID": "bedrock-anthropic-eu-sonnet-55-affordable",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sol": {
          "name": "Sol 6.1",
          "modelID": "openai-glob-sol-61-expensive",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh"] }
          },
          "limit": { "context": 922000, "output": 128000 }
        },
        "luna": {
          "name": "Luna 6",
          "modelID": "openai-glob-luna-6-cheap",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh"] }
          },
          "limit": { "context": 922000, "output": 128000 }
        }
      }
    }
  },
  "model": "litellm/opus",
{{- else }}
  "model": "openai/gpt-6.1-sol",
{{- end }}
  "default_agent": "plan",
  "update": "disable",
  "share": "disabled",
  "worktree": {
    "directory": "~/Developer/worktrees/opencode"
  },
{{- if eq .workstation_type "work" }}
  "mcp": {
    "servers": {
      "eventim-mcp": {
        "type": "local",
        "command": ["node", "{{ .chezmoi.homeDir }}/Developer/git.eventim.net/shemleb/eventim-mcp/dist/index.js", "--stdio"]
      }
    }
  },
{{- end }}
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
{{- if eq .workstation_type "work" }}
      "model": "litellm/opus#max",
{{- else }}
      "model": "openai/gpt-6.1-sol#xhigh",
{{- end }}
      "permissions": [
{{- if eq .workstation_type "work" }}
        { "action": "eventim-mcp_*", "resource": "*", "effect": "deny" },
        { "action": "eventim-mcp_*-get-*", "resource": "*", "effect": "allow" },
        { "action": "eventim-mcp_*-list*", "resource": "*", "effect": "allow" },
        { "action": "eventim-mcp_*-search*", "resource": "*", "effect": "allow" },
        { "action": "eventim-mcp_jira-find-user", "resource": "*", "effect": "allow" },
        { "action": "eventim-mcp_grafana-ask-assistant", "resource": "*", "effect": "allow" },
{{- end }}
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "git -C * commit*", "effect": "deny" },
        { "action": "shell", "resource": "git -C * push*", "effect": "deny" },
        { "action": "shell", "resource": "glab mr create*", "effect": "deny" },
        { "action": "shell", "resource": "glab mr update*", "effect": "deny" },
        { "action": "shell", "resource": "glab mr merge*", "effect": "deny" },
        { "action": "shell", "resource": "glab mr approve*", "effect": "deny" },
        { "action": "shell", "resource": "kubectl * apply *", "effect": "deny" },
        { "action": "shell", "resource": "kubectl * delete *", "effect": "deny" },
        { "action": "shell", "resource": "terraform *apply*", "effect": "deny" },
        { "action": "shell", "resource": "terraform *destroy*", "effect": "deny" },
        { "action": "shell", "resource": "terragrunt *apply*", "effect": "deny" },
        { "action": "shell", "resource": "terragrunt *destroy*", "effect": "deny" }
      ]
    },
    "organize": {
      "description": "Organize work without changing code: Jira tickets, Herdr workspaces, worktrees and agents. Edits and commits ask first",
      "mode": "primary",
      "color": "#d29922",
{{- if eq .workstation_type "work" }}
      "model": "litellm/opus#high",
{{- else }}
      "model": "openai/gpt-6.1-sol#high",
{{- end }}
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
{{- if env "TMPDIR" | hasPrefix "/var/" }}
        { "action": "edit", "resource": "/private{{ env "TMPDIR" | trimSuffix "/" }}/opencode/*", "effect": "allow" },
{{- end }}
{{- if eq .workstation_type "work" }}
        { "action": "eventim-mcp_jira-*", "resource": "*", "effect": "allow" },
        { "action": "eventim-mcp_safari-open-*", "resource": "*", "effect": "allow" },
        { "action": "eventim-mcp_safari-focus-*", "resource": "*", "effect": "allow" },
