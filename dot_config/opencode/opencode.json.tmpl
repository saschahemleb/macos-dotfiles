{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./litellm-token-refresh"],
{{- if eq .workstation_type "work" }}
  "providers": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-central-1",
        "profile": "ClaudeCode"
      },
      "models": {
        "opus": {
          "name": "Eventim Opus",
          "id": "arn:aws:bedrock:eu-central-1:045615991133:application-inference-profile/a0r9n3jfwx3h"
        }
      }
    },
    "litellm": {
      "name": "Eventim LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["LITELLM_API_KEY"],
      "settings": {
        "baseURL": "https://litellm.stg.enablement.ai.eventim.cloud/v1"
      },
      "body": {
        "drop_params": true
      },
      "models": {
        "opus": {
          "name": "Opus",
          "modelID": "bedrock-anthropic-eu-opus-55-expensive",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sonnet": {
          "name": "Sonnet",
          "modelID": "bedrock-anthropic-eu-sonnet-55-affordable",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "sol": {
          "name": "Sol",
          "modelID": "openai-glob-sol-61-expensive",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 922000, "output": 128000 }
        },
        "luna": {
          "name": "Luna",
          "modelID": "openai-glob-luna-6-cheap",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 922000, "output": 128000 }
        }
      }
    }
  },
  "model": "litellm/opus#high",
{{- else }}
  "model": "openai/gpt-6.1-sol#high",
{{- end }}
  "default_agent": "build",
  "update": "disable",
  "share": "disabled",
  "agents": {
    "build": {
{{- if eq .workstation_type "work" }}
      "model": "litellm/opus#medium"
{{- else }}
      "model": "openai/gpt-6.1-sol#medium"
{{- end }}
    },
    "plan": {
{{- if eq .workstation_type "work" }}
      "model": "litellm/opus#high"
{{- else }}
      "model": "openai/gpt-6.1-sol#high"
{{- end }}
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/dev/null", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "command *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "zoxide *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "herdr *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "nl *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "sed -n*", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "npm run test*", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint*", "effect": "allow" },
    { "action": "shell", "resource": "npm run build*", "effect": "allow" },
    { "action": "shell", "resource": "npm run check*", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck*", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run test*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run lint*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run build*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run check*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run typecheck*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
    { "action": "shell", "resource": "bun run test*", "effect": "allow" },
    { "action": "shell", "resource": "bun run lint*", "effect": "allow" },
    { "action": "shell", "resource": "bun run build*", "effect": "allow" },
    { "action": "shell", "resource": "bun run check*", "effect": "allow" },
    { "action": "shell", "resource": "bun run typecheck*", "effect": "allow" },
    { "action": "shell", "resource": "bun test *", "effect": "allow" },
    { "action": "shell", "resource": "composer run-script test*", "effect": "allow" },
    { "action": "shell", "resource": "composer run-script lint*", "effect": "allow" },
    { "action": "shell", "resource": "composer run-script check*", "effect": "allow" },
    { "action": "shell", "resource": "composer run-script analyse*", "effect": "allow" },
    { "action": "shell", "resource": "php -l *", "effect": "allow" },
    { "action": "shell", "resource": "vendor/bin/phpunit *", "effect": "allow" },
    { "action": "shell", "resource": "vendor/bin/pest *", "effect": "allow" },
    { "action": "shell", "resource": "vendor/bin/phpstan *", "effect": "allow" },
    { "action": "shell", "resource": "biome check *", "effect": "allow" },
    { "action": "shell", "resource": "biome lint *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "go vet *", "effect": "allow" },
    { "action": "shell", "resource": "chezmoi diff *", "effect": "allow" },
    { "action": "shell", "resource": "chezmoi status *", "effect": "allow" },
    { "action": "shell", "resource": "biome * --write*", "effect": "ask" },
    { "action": "shell", "resource": "biome * --fix*", "effect": "ask" },
    { "action": "shell", "resource": "git * --output*", "effect": "ask" },
    { "action": "shell", "resource": "*deploy*", "effect": "ask" },
    { "action": "shell", "resource": "*publish*", "effect": "ask" },
    { "action": "shell", "resource": "*release*", "effect": "ask" },
    { "action": "shell", "resource": "sed *-i*", "effect": "ask" }
  ]
}
