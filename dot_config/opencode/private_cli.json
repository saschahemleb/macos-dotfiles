{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "tabs": {
    "mode": "off"
  },
  "diffs": {
    "view": "auto"
  },
  "scroll": {
    "acceleration": true
  },
  "keybinds": {
    "leader": "ctrl+x",
    "input.line.home": "home",
    "model.dialog.provider": "<leader>p"
  },
  "plugins": ["./herdr-opencode"]
}
