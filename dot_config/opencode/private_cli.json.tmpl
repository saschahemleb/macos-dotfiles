{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "animations": true,
  "prompt": {
    "image_preview": false
  },
  "tabs": {
    "mode": "off"
  },
  "diffs": {
    "view": "auto"
  },
  "scroll": {
    "acceleration": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": false,
    "tps": false,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "keybinds": {
    "input.line.home": "home",
    "model.dialog.provider": "<leader>p"
  },
  "plugins": ["./herdr-opencode"{{ if eq .workstation_type "private" }}, "./codex-usage"{{ end }}]
}
