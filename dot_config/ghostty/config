auto-update-channel = tip
shell-integration = detect
shell-integration-features = cursor,sudo,no-title,ssh-env,no-ssh-terminfo
mouse-hide-while-typing = true
window-save-state = always
scrollback-limit = 50000000

macos-non-native-fullscreen = true
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = hidden
macos-window-buttons = hidden

font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true
font-feature = zero,calt

theme = light:Clear Light,dark:Catthode

window-padding-x = 14
window-padding-y = 12
window-theme = system

keybind = ctrl+n=new_window
keybind = ctrl+space>space=toggle_command_palette
keybind = super+t=new_window
