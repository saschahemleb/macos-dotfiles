#!/usr/bin/env bash

set -Eeuo pipefail

brew update

brew bundle --file=/dev/stdin <<EOF
{{ range .homebrew_packages.all.brews -}}
{{ if kindIs "string" . -}}
brew {{ . | quote }}
{{ else -}}
brew {{ .name | quote }}, args: {{ .args | toJson }}
{{ end -}}
{{ end -}}
{{ range .homebrew_packages.all.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .homebrew_packages.all.vscode_extensions -}}
vscode {{ . | quote }}
{{ end -}}
{{ if eq .workstation_type "work" -}}
{{ range .homebrew_packages.work.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .homebrew_packages.work.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .homebrew_packages.work.vscode_extensions -}}
vscode {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .workstation_type "private" -}}
{{ range .homebrew_packages.private.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .homebrew_packages.private.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .homebrew_packages.private.vscode_extensions -}}
vscode {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
