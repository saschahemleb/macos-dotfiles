[user]
    name = Sascha Hemleb
    email = {{ .email }}
    signingkey = "~/.ssh/id_ed25519"
[core]
    editor = $EDITOR
    excludesfile = ~/.gitignore
{{- if lookPath "security" }}
[credential]
	helper = osxkeychain
{{- end }}
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[init]
	defaultBranch = main
