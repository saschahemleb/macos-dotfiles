# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
# https://ghostty.org/docs/config.
auto-update-channel = tip
shell-integration = detect
shell-integration-features = cursor,sudo,no-title,ssh-env,no-ssh-terminfo
mouse-hide-while-typing = true
window-save-state = always
scrollback-limit = 50000000

# tabs
macos-non-native-fullscreen = true
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs
macos-window-buttons = hidden

font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true
font-feature = zero,calt

theme = light:Tango Half Adapted,dark:TokyoNight

window-padding-x = 15
window-padding-y = 10
window-theme = system

keybind = ctrl+n=new_window
keybind = ctrl+space>space=toggle_command_palette

# ghostty splits disabled — using herdr pane management instead

