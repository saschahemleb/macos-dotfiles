#!/usr/bin/env bash
# Wrapper that fetches a fresh Entra ID token, restarts the OpenCode background
# service so it picks up the token, then launches OpenCode.
set -euo pipefail

ENTRA_CLI_AUTH="${HOME}/.local/bin/entra-cli-auth"

if [[ ! -x "$ENTRA_CLI_AUTH" ]]; then
  echo "error: entra-cli-auth not found at ${ENTRA_CLI_AUTH}" >&2
  exit 1
fi

token="$("$ENTRA_CLI_AUTH")"

if [[ -z "$token" ]]; then
  echo "error: entra-cli-auth returned an empty token" >&2
  exit 1
fi

export LITELLM_API_KEY="$token"
opencode service restart >/dev/null 2>&1 || true
exec opencode "$@"
