#!/bin/zsh

set -eu

cache_dir="${XDG_CACHE_HOME:-$HOME/Library/Caches}/k9s-ghostty"
mkdir -p "$cache_dir"

terminal_id=""
if [[ -f "$cache_dir/terminal-id" ]]; then
  terminal_id="$(<"$cache_dir/terminal-id")"
fi

terminal_id="$(/usr/bin/osascript - "$terminal_id" <<'APPLESCRIPT'
on run argv
  set previousID to item 1 of argv
  tell application "Ghostty"
    if previousID is not "" then
      repeat with candidate in terminals
        if id of candidate is previousID then
          focus candidate
          activate
          return id of candidate
        end if
      end repeat
    end if

    set config to new surface configuration
    set command of config to "/bin/zsh -lic 'exec k9s'"
    set wait after command of config to false
    set k9sWindow to new window with configuration config
    set k9sTerminal to focused terminal of selected tab of k9sWindow
    activate
    return id of k9sTerminal
  end tell
end run
APPLESCRIPT
)"

print -r -- "$terminal_id" > "$cache_dir/terminal-id"
