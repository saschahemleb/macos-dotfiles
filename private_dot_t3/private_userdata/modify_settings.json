{{- /* chezmoi:modify-template */ -}}
{{- $pinned := `{
  "defaultRuntimeMode": "auto",
  "defaultThreadEnvMode": "worktree",
  "defaultAutoPull": true,
  "idleCompaction": "onReturn",
  "branchNamingMode": "semantic",
  "branchNamePrefix": "",
  "removeAgentCreditsOnMerge": true,
  "reviewGuidesEnabled": true,
  "storageCleanup.worktreeOnMerge": true,
  "storageCleanup.worktreeOnDelete": true,
  "providerInstances.codex": { "driver": "codex", "enabled": true },
  "providerInstances.claudeAgent": { "driver": "claudeAgent", "enabled": false },
  "providerInstances.opencode": { "driver": "opencode", "enabled": false }
}` | fromJson -}}
{{- if eq .workstation_type "work" -}}
{{-   $effort := `{
  "optionDescriptors": [{
    "id": "effort",
    "label": "Reasoning",
    "type": "select",
    "options": [
      { "id": "low", "label": "Low" },
      { "id": "medium", "label": "Medium", "isDefault": true },
      { "id": "high", "label": "High" },
      { "id": "xhigh", "label": "Extra High" },
      { "id": "max", "label": "Max" }
    ]
  }]
}` | fromJson -}}
{{- /* Codex lists every model from LiteLLM's /v1/models as built-in. Keep this list in sync with it. */ -}}
{{-   $litellmModels := list
  "bedrock-anthropic-eu-haiku-45-cheap"
  "bedrock-anthropic-eu-opus-46-expensive"
  "bedrock-anthropic-eu-opus-48-expensive"
  "bedrock-anthropic-eu-opus-55-expensive"
  "bedrock-anthropic-eu-sonnet-46-affordable"
  "bedrock-anthropic-eu-sonnet-5-affordable"
  "bedrock-anthropic-eu-sonnet-55-affordable"
  "bedrock-moonshotai-glob-kimi-k3-affordable"
  "claude-openai-glob-4o-affordable"
  "claude-openai-glob-luna-56-cheap"
  "claude-openai-glob-luna-6-cheap"
  "claude-openai-glob-sol-56-expensive"
  "claude-openai-glob-sol-61-expensive"
  "claude-openai-glob-terra-56-affordable"
  "claude-openai-luna-cheap"
  "openai-glob-4o-affordable"
  "openai-glob-luna-56-cheap"
  "openai-glob-luna-6-cheap"
  "openai-glob-sol-56-expensive"
  "openai-glob-sol-61-expensive"
  "openai-glob-terra-56-affordable"
-}}
{{- /* Codex's own models, shown when it can't reach LiteLLM. */ -}}
{{-   $codexBuiltInModels := list
  "gpt-6.1-sol"
  "gpt-6.1-terra"
  "gpt-6-astra"
  "gpt-6-luna"
  "gpt-6-sol"
  "gpt-5.6-sol"
  "gpt-5.6-terra"
  "gpt-5.6-luna"
  "gpt-5.5"
  "gpt-5.4-mini"
  "gpt-5.3-codex-spark"
-}}
{{-   $claudeBuiltInModels := list
  "claude-opus-5-5"
  "claude-sonnet-5-5"
  "claude-fable-5-1"
  "claude-fable-5"
  "claude-opus-5"
  "claude-opus-4-8"
  "claude-opus-4-7"
  "claude-opus-4-6"
  "claude-opus-4-5"
  "claude-sonnet-5"
  "claude-sonnet-4-6"
  "claude-haiku-5-5"
  "claude-haiku-4-5"
-}}
{{- /* T3 Code drops a Codex custom model that Codex already lists, so these must stay out of the hidden list. */ -}}
{{-   $codexModels := list "openai-glob-sol-61-expensive" "openai-glob-terra-56-affordable" "openai-glob-luna-6-cheap" -}}
{{-   $codexHidden := concat $codexBuiltInModels $litellmModels -}}
{{-   range $codexModels -}}
{{-     $codexHidden = without $codexHidden . -}}
{{-   end -}}
{{-   $pinned = merge (dict
  "providerModelPreferences.codex.hiddenModels" $codexHidden
  "providerModelPreferences.codex.modelOrder" $codexModels
  "providerModelPreferences.claudeAgent.hiddenModels" $claudeBuiltInModels
  "providerInstances.claudeAgent" (dict
    "driver" "claudeAgent"
    "enabled" true
    "config" (dict "customModels" (list
      (dict "slug" "bedrock-anthropic-eu-opus-55-expensive" "name" "Opus 5.5" "capabilities" $effort)
      (dict "slug" "bedrock-anthropic-eu-sonnet-55-affordable" "name" "Sonnet 5.5" "capabilities" $effort)
      (dict "slug" "bedrock-anthropic-eu-haiku-45-cheap" "name" "Haiku 4.5" "capabilities" (dict "optionDescriptors" list))
    ))
  )
  "providerInstances.codex" (dict
    "driver" "codex"
    "enabled" true
    "config" (dict "customModels" (list
      (dict "slug" "openai-glob-sol-61-expensive" "name" "Sol 6.1")
      (dict "slug" "openai-glob-terra-56-affordable" "name" "Terra 5.6")
      (dict "slug" "openai-glob-luna-6-cheap" "name" "Luna 6")
    ))
  )
) (`{
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "bedrock-anthropic-eu-opus-55-expensive",
    "options": [{ "id": "effort", "value": "medium" }]
  },
  "fallbackModelSelection": { "instanceId": "codex", "model": "openai-glob-sol-61-expensive" },
  "textGenerationModelSelection": {
    "instanceId": "claudeAgent",
    "model": "bedrock-anthropic-eu-sonnet-55-affordable",
    "options": [{ "id": "effort", "value": "low" }]
  },
  "favorites": [
    { "provider": "claudeAgent", "model": "bedrock-anthropic-eu-opus-55-expensive" },
    { "provider": "codex", "model": "openai-glob-sol-61-expensive" }
  ]
}` | fromJson) $pinned -}}
{{- else -}}
{{-   $pinned = merge (`{
  "defaultModelSelection": { "instanceId": "codex", "model": "gpt-6.1-sol" },
  "fallbackModelSelection": null,
  "textGenerationModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [{ "id": "reasoningEffort", "value": "low" }]
  }
}` | fromJson) $pinned -}}
{{- end -}}
{{- includeTemplate "pin-settings" (dict "stdin" .chezmoi.stdin "format" "json" "pinned" $pinned "removed" list) -}}
