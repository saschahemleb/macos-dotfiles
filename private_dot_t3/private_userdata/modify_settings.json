{{- /* chezmoi:modify-template */ -}}
{{- $pinned := `{
  "defaultRuntimeMode": "auto",
  "defaultThreadEnvMode": "worktree",
  "defaultAutoPull": true,
  "idleCompaction": "onReturn",
  "branchNamePrefix": "semantic",
  "removeAgentCreditsOnMerge": true,
  "reviewGuidesEnabled": true,
  "storageCleanup.worktreeOnMerge": true,
  "storageCleanup.worktreeOnDelete": true,
  "providerInstances.codex": { "driver": "codex", "enabled": true },
  "providerInstances.claudeAgent": { "driver": "claudeAgent", "enabled": false },
  "providerInstances.opencode": { "driver": "opencode", "enabled": false }
}` | fromJson -}}
{{- if eq .workstation_type "work" -}}
{{-   $effort := `{
  "optionDescriptors": [{
    "id": "effort",
    "label": "Reasoning",
    "type": "select",
    "options": [
      { "id": "low", "label": "Low" },
      { "id": "medium", "label": "Medium", "isDefault": true },
      { "id": "high", "label": "High" },
      { "id": "xhigh", "label": "Extra High" },
      { "id": "max", "label": "Max" }
    ]
  }]
}` | fromJson -}}
{{-   $pinned = merge (dict
  "providerInstances.claudeAgent" (dict
    "driver" "claudeAgent"
    "enabled" true
    "config" (dict "customModels" (list
      (dict "slug" "bedrock-anthropic-eu-opus-55-expensive" "name" "Opus 5.5" "capabilities" $effort)
      (dict "slug" "bedrock-anthropic-eu-sonnet-55-affordable" "name" "Sonnet 5.5" "capabilities" $effort)
      (dict "slug" "bedrock-anthropic-eu-haiku-45-cheap" "name" "Haiku 4.5" "capabilities" (dict "optionDescriptors" list))
    ))
  )
  "providerInstances.codex" (dict
    "driver" "codex"
    "enabled" true
    "config" (dict "customModels" (list
      (dict "slug" "openai-glob-sol-61-expensive" "name" "Sol 6.1")
      (dict "slug" "openai-glob-luna-6-cheap" "name" "Luna 6")
    ))
  )
) (`{
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "bedrock-anthropic-eu-opus-55-expensive",
    "options": [{ "id": "effort", "value": "medium" }]
  },
  "fallbackModelSelection": { "instanceId": "codex", "model": "openai-glob-sol-61-expensive" },
  "textGenerationModelSelection": {
    "instanceId": "claudeAgent",
    "model": "bedrock-anthropic-eu-sonnet-55-affordable",
    "options": [{ "id": "effort", "value": "low" }]
  },
  "favorites": [
    { "provider": "claudeAgent", "model": "bedrock-anthropic-eu-opus-55-expensive" },
    { "provider": "codex", "model": "openai-glob-sol-61-expensive" }
  ]
}` | fromJson) $pinned -}}
{{- else -}}
{{-   $pinned = merge (`{
  "defaultModelSelection": { "instanceId": "codex", "model": "gpt-6.1-sol" },
  "fallbackModelSelection": null,
  "textGenerationModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [{ "id": "reasoningEffort", "value": "low" }]
  }
}` | fromJson) $pinned -}}
{{- end -}}
{{- includeTemplate "pin-settings" (dict "stdin" .chezmoi.stdin "format" "json" "pinned" $pinned "removed" list) -}}
