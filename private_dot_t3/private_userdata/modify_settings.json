{{- /* chezmoi:modify-template */ -}}
{{- $pinned := `{
  "defaultRuntimeMode": "auto",
  "defaultAutoPull": true,
  "branchNamingMode": "semantic",
  "branchNamePrefix": "",
  "projectSettingsFolded": true,
  "storageCleanup": { "worktreeOnMerge": true, "worktreeOnDelete": true },
  "removeAgentCreditsOnMerge": true,
  "reviewGuidesEnabled": true,
  "addProjectBaseDirectory": "~/Developer/",
  "providerInstances.codex.config.setupMode": "existing"
}` | fromJson -}}
{{- if eq .workstation_type "work" -}}
{{-   $effort := `{
  "optionDescriptors": [{
    "id": "effort",
    "label": "Reasoning",
    "type": "select",
    "options": [
      { "id": "low", "label": "Low" },
      { "id": "medium", "label": "Medium", "isDefault": true },
      { "id": "high", "label": "High" },
      { "id": "xhigh", "label": "Extra High" },
      { "id": "max", "label": "Max" }
    ]
  }]
}` | fromJson -}}
{{- /* T3 Code has no way to list Claude models from LiteLLM, so they are custom models. Codex gets its models from the catalog in ~/.codex/litellm_models.json. */ -}}
{{-   $claudeBuiltInModels := list
  "claude-opus-5-5"
  "claude-sonnet-5-5"
  "claude-fable-5-1"
  "claude-fable-5"
  "claude-opus-5"
  "claude-opus-4-8"
  "claude-opus-4-7"
  "claude-opus-4-6"
  "claude-opus-4-5"
  "claude-sonnet-5"
  "claude-sonnet-4-6"
  "claude-haiku-5-5"
  "claude-haiku-4-5"
-}}
{{-   $pinned = merge (dict
  "providerModelPreferences.codex.hiddenModels" (list
    "openai-glob-sol-56-expensive"
    "openai-glob-luna-56-cheap"
    "openai-glob-4o-affordable"
  )
  "providerModelPreferences.codex.modelOrder" (list
    "openai-glob-sol-61-expensive"
    "openai-glob-terra-56-affordable"
    "openai-glob-luna-6-cheap"
  )
  "providerModelPreferences.claudeAgent.hiddenModels" $claudeBuiltInModels
  "providerInstances.claudeAgent" (dict
    "driver" "claudeAgent"
    "enabled" true
    "config" (dict "customModels" (list
      (dict "slug" "bedrock-anthropic-eu-opus-55-expensive" "name" "Opus 5.5" "capabilities" $effort)
      (dict "slug" "bedrock-anthropic-eu-sonnet-55-affordable" "name" "Sonnet 5.5" "capabilities" $effort)
      (dict "slug" "bedrock-anthropic-eu-haiku-45-cheap" "name" "Haiku 4.5" "capabilities" (dict "optionDescriptors" list))
    ))
  )
) (`{
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "bedrock-anthropic-eu-sonnet-55-affordable",
    "options": [{ "id": "effort", "value": "medium" }]
  },
  "textGenerationModelSelection": {
    "instanceId": "codex",
    "model": "openai-glob-luna-6-cheap",
    "options": [{ "id": "reasoningEffort", "value": "low" }]
  },
  "favorites": [
    { "provider": "claudeAgent", "model": "bedrock-anthropic-eu-opus-55-expensive" },
    { "provider": "codex", "model": "openai-glob-sol-61-expensive" }
  ]
}` | fromJson) $pinned -}}
{{- else -}}
{{-   $pinned = merge (`{
  "providerInstances.claudeAgent.enabled": false,
  "providerModelPreferences.codex.hiddenModels": ["gpt-6-sol", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"],
  "defaultModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6.1-sol",
    "options": [
      { "id": "reasoningEffort", "value": "low" },
      { "id": "serviceTier", "value": "default" }
    ]
  }
}` | fromJson) $pinned -}}
{{- end -}}
{{- includeTemplate "pin-settings" (dict "stdin" .chezmoi.stdin "format" "json" "pinned" $pinned "removed" (list "sourceControlWriterModelSelection" "reviewGuideModelSelection" "fallbackModelSelection")) -}}
