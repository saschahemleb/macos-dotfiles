{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $pinned := `{
  "defaultRuntimeMode": "approval-required",
  "defaultThreadEnvMode": "worktree",
  "defaultAutoPull": true,
  "idleCompaction": "onReturn",
  "branchNamePrefix": "",
  "removeAgentCreditsOnMerge": true,
  "reviewGuidesEnabled": true,
  "storageCleanup.worktreeOnMerge": true,
  "storageCleanup.worktreeOnDelete": true,
  "providerInstances.codex": { "driver": "codex", "enabled": false },
  "providerInstances.claudeAgent": { "driver": "claudeAgent", "enabled": false },
  "providerInstances.opencode": { "driver": "opencode", "displayName": "OpenCode", "enabled": true }
}` | fromJson -}}
{{- if eq .workstation_type "work" -}}
{{-   $pinned = merge (`{
  "defaultModelSelection": {
    "instanceId": "opencode",
    "model": "litellm/opus",
    "options": [{ "id": "variant", "value": "medium" }]
  },
  "fallbackModelSelection": { "instanceId": "opencode", "model": "litellm/sol" },
  "textGenerationModelSelection": {
    "instanceId": "opencode",
    "model": "litellm/sonnet",
    "options": [{ "id": "variant", "value": "low" }]
  },
  "favorites": [
    { "provider": "opencode", "model": "litellm/opus" },
    { "provider": "opencode", "model": "litellm/sol" }
  ]
}` | fromJson) $pinned -}}
{{- end -}}
{{- $changed := false -}}
{{- range $path, $value := $pinned -}}
{{-   $cursor := $current -}}
{{-   $found := true -}}
{{-   range $key := splitList "." $path -}}
{{-     if and $found (kindIs "map" $cursor) (hasKey $cursor $key) -}}
{{-       $cursor = index $cursor $key -}}
{{-     else -}}
{{-       $found = false -}}
{{-     end -}}
{{-   end -}}
{{-   if or (not $found) (ne (toJson $cursor) (toJson $value)) -}}
{{-     $changed = true -}}
{{-     $current = setValueAtPath $path $value $current -}}
{{-   end -}}
{{- end -}}
{{- /* T3 Code writes this file in its own format, so keep its bytes unless a pinned value changes. */ -}}
{{- if and .chezmoi.stdin (not $changed) -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ toPrettyJson $current }}
{{- end -}}
